# Holy Grills frontend — environment template.
#
# Copy to .env.local for local overrides. Every variable is optional: each one
# falls back to the production value in code, so an empty file behaves exactly
# like the current deployment.

# Flask API base, no trailing slash (lib/apiClient.ts).
VITE_API_BASE_URL=https://holy-grills-backend.onrender.com/api

# Public site origin — canonical URLs, og:url, JSON-LD url (config/app.config.ts).
VITE_SITE_URL=https://holy-grills.vercel.app

# Asset host for mascots and logos (lib/mascots.ts). Base44's CDN today; set this
# to the Cloudinary base when the artwork moves, and the paths keep working.
VITE_ASSET_CDN_URL=https://media.base44.com/images/public

# Web push. Push stays disabled while this is empty (config/app.config.ts).
VITE_ONESIGNAL_APP_ID=

# Development only: forward relative /api calls to a real backend from
# `npm run dev` (vite.config.ts). Leave empty to disable the proxy.
VITE_DEV_PROXY_TARGET=
