{
  "name": "holy-grills-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run routes:check && npm run messages:check && npm run test:value-text && npm run build:client && npm run build:ssr && npm run prerender",
    "routes:check": "node scripts/sync-routes.mjs --check",
    "routes:sync": "node scripts/sync-routes.mjs --write",
    "messages:check": "node scripts/messages-check.mjs",
    "messages:fix": "node scripts/messages-check.mjs --fix",
    "serve": "node scripts/serve-static.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:safe-navigation": "node scripts/test-safe-navigation.mjs",
    "test:value-text": "node scripts/test-value-text.mjs"
  },
